        {
          "name": "Login (equipe)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Emite o JWT de Atendente/Mecanico/Gerente. O teste salva `accessToken` em {{token}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"gerente@oficina.local\",\n  \"senha\": \"Senha@12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login 200', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('token', j.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Bootstrap (primeiro Gerente)",
          "request": {
